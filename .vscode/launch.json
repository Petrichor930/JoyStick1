			"servertype": "openocd",
			"device": "stm32f411ceux",
			"configFiles": [
				"${workspaceFolder}/openocd/stlink.cfg",
				"target/stm32f4x.cfg"
			],
			"armToolchainPath": "D:\\APP\\devEnvCong\\toolchain\\bin",
			"liveWatch": {
				"enabled": true,
				"samplesPerSecond": 10
			},
			"preLaunchTask": "build"
		}
