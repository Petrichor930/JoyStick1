			"armToolchainPath": "D:\\APP\\devEnvCong\\toolchain\\bin",
			"liveWatch": {
				"enabled": true,
				"samplesPerSecond": 10
			},
			"preLaunchTask": "build"
		},
		{
			"name": "ST-Link",
			"type": "cortex-debug",
			"request": "launch",
			"showDevDebugOutput": "none",
			"cwd": "${workspaceFolder}",
